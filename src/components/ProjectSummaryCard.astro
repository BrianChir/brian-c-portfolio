---
import { analyticsAttributes } from '../lib/analytics';

interface Props {
  number: string;
  category: string;
  status?: string;
  title: string;
  description: string;
  href: string;
}

const { number, category, status, title, description, href } = Astro.props;
const statusTone = status?.toLowerCase().includes('live')
  ? 'border-emerald-500/30 bg-emerald-500/10 text-emerald-200'
  : status?.toLowerCase().includes('development')
    ? 'border-amber-500/35 bg-amber-500/10 text-amber-200'
    : 'border-border bg-surface-alt text-text-secondary';
---

<article class="surface-hover rounded-lg border border-border bg-surface-card hover:border-accent hover:bg-surface-alt">
  <a href={href} class="group block h-full cursor-pointer p-5" {...analyticsAttributes('cta_click', `project-${number}`)}>
    <p class="mb-4 font-display text-[28px] italic text-accent/60">{number}</p>
    <div class="mb-3 flex flex-wrap items-center gap-2">
      <p class="m-0 text-label-sm font-semibold uppercase text-text-secondary">{category}</p>
      {status && (
        <span class:list={[
          'rounded border px-2 py-0.5 text-label-sm font-medium normal-case tracking-normal',
          statusTone,
        ]}>
          {status}
        </span>
      )}
    </div>
    <h2 class="mb-3 font-display text-case-title font-medium text-text transition-colors duration-200 group-hover:text-accent">{title}</h2>
    <p class="m-0 text-body-sm text-text-secondary">{description}</p>
  </a>
</article>
