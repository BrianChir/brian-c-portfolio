---
interface Role {
  title: string;
  period: string;
  summary: string;
}

interface Item {
  company: string;
  url: string;
  location: string;
  roles: Role[];
}

interface Props {
  items: Item[];
}

const { items } = Astro.props;
---

<div class="experience-list">
  {items.map((item) => (
    <article class="group border-b border-border py-6 transition-colors duration-200 hover:border-accent hover:bg-surface-alt">
      <div class="grid gap-4 sm:grid-cols-[140px_minmax(0,1fr)_112px] sm:items-start">
        <a
          href={item.url}
          class="ui-link min-h-12 cursor-pointer text-body-sm font-bold text-text"
          aria-label={`${item.company} website`}
        >
          {item.company}
        </a>
        <div class="min-w-0">
          {item.roles.map((role) => (
            <div class="mb-5 last:mb-0">
              <div class="flex flex-col gap-1 sm:flex-row sm:items-start sm:justify-between">
                <p class="m-0 text-body-sm font-bold text-text">{role.title}</p>
                <p class="m-0 text-body-xs text-text-secondary sm:ml-4 sm:shrink-0 sm:text-right">{role.period}</p>
              </div>
              <p class="m-0 text-body-xs text-text-secondary">{role.summary}</p>
            </div>
          ))}
        </div>
        <p class="m-0 text-body-xs text-text-secondary sm:text-right">{item.location}</p>
      </div>
    </article>
  ))}
</div>
