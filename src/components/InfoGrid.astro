---
interface Item {
  label: string;
  value: string;
}

interface Props {
  items: Item[];
}

const { items } = Astro.props;
---

<div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
  {items.map((item) => (
    <article class="surface-hover rounded-lg border border-border bg-surface-card px-5 py-4 hover:border-accent hover:bg-surface-alt">
      <p class="mb-2 text-label-sm font-semibold uppercase text-text-secondary">{item.label}</p>
      <p class="m-0 text-body-xs text-text-secondary">{item.value}</p>
    </article>
  ))}
</div>
