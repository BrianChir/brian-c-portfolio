---
interface Item {
  label: string;
  value: string;
}

interface Props {
  items: Item[];
}

const { items } = Astro.props;
---

<div class="mt-10 grid gap-px overflow-hidden rounded-lg border border-border bg-border sm:grid-cols-2">
  {items.map((item) => (
    <div class="surface-hover bg-surface-card px-5 py-[18px] hover:bg-surface-alt">
      <p class="mb-2 text-label-sm font-semibold uppercase text-text-secondary">{item.label}</p>
      <p class="m-0 text-body-xs text-text-secondary">{item.value}</p>
    </div>
  ))}
</div>
