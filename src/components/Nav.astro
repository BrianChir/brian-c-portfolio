---
import { navItems, siteMeta } from '../data/site';
import { analyticsAttributes } from '../lib/analytics';
interface Props { pathname: string; }
const { pathname } = Astro.props;
---
<nav class="fixed inset-x-0 top-0 z-50 h-[52px] border-b border-border bg-surface/95 backdrop-blur-sm">
  <div class="section-shell flex h-full items-center justify-between">
    <a href="/" class="font-display text-[20px] font-semibold" aria-label="Brian Chirchir home">BC<span class="text-accent">.</span></a>
    <div class="hidden h-full items-center gap-6 sm:flex">
      {navItems.map((item) => {
        const active = pathname === item.href;
        return <a href={item.href} class:list={['relative flex h-full items-center text-[12px]', active ? 'font-semibold text-text after:absolute after:inset-x-0 after:bottom-0 after:h-[2px] after:bg-accent' : 'text-text-secondary hover:text-text']} aria-current={active ? 'page' : undefined}>{item.label}</a>;
      })}
    </div>
    <div class="flex items-center gap-2">
      <a href={siteMeta.bookingUrl} class="rounded-full bg-text px-4 py-2 text-[10px] font-bold uppercase tracking-wide text-white" {...analyticsAttributes('cta_click','nav-booking')}>Book a call</a>
      <a href="/about" class="flex size-8 items-center justify-center rounded-full bg-accent text-white" aria-label="About Brian">●</a>
      <details class="relative sm:hidden">
        <summary class="flex size-8 cursor-pointer list-none items-center justify-center rounded-full border border-border bg-white" aria-label="Open navigation"><span aria-hidden="true">≡</span></summary>
        <div class="absolute right-0 top-10 w-44 rounded-md border border-border bg-white p-2 shadow-lg">
          {navItems.map((item) => <a href={item.href} class="block rounded px-3 py-3 text-[12px] text-text-secondary hover:bg-surface-alt hover:text-text">{item.label}</a>)}
        </div>
      </details>
    </div>
  </div>
</nav>
