---
import { navItems, siteMeta } from '../data/site';
import { analyticsAttributes } from '../lib/analytics';

interface Props {
  pathname: string;
}

const { pathname } = Astro.props;
---

<nav class="fixed inset-x-0 top-0 z-50 border-b border-border bg-surface/90 backdrop-blur-md">
  <div class="section-shell flex min-h-[52px] items-center justify-between gap-4 py-2">
    <a
      href="/"
      class="inline-flex min-h-12 min-w-12 cursor-pointer items-center font-display text-[17px] font-semibold"
      aria-label="Brian Chirchir home"
      {...analyticsAttributes('cta_click', 'nav-logo')}
    >
      BC<span class="text-accent">.</span>
    </a>

    <div class="hidden items-center gap-5 lg:flex">
      {navItems.map((item) => {
        const active = pathname === item.href;
        return (
          <a
            href={item.href}
            class:list={[
              'inline-flex min-h-12 cursor-pointer items-center py-3 text-[13px] transition-colors duration-200',
              active ? 'font-semibold text-text' : 'font-normal text-text-muted hover:text-text',
            ]}
            aria-current={active ? 'page' : undefined}
          >
            {item.label}
          </a>
        );
      })}
    </div>

    <div class="flex items-center gap-3">
      <a
        href={`mailto:${siteMeta.email}`}
        class="surface-hover inline-flex min-h-12 cursor-pointer items-center rounded bg-accent px-4 py-2 text-[12px] font-semibold text-surface transition-colors duration-200 hover:bg-text"
        {...analyticsAttributes('cta_click', 'nav-contact')}
      >
        Let's talk
      </a>

      <details class="lg:hidden">
        <summary class="surface-hover flex min-h-12 min-w-12 cursor-pointer list-none items-center justify-center rounded border border-border bg-surface-card text-text transition-colors duration-200 hover:border-accent">
          <span class="sr-only">Open navigation menu</span>
          <span class="block h-[2px] w-4 bg-current shadow-[0_5px_0_0_currentColor,0_-5px_0_0_currentColor]"></span>
        </summary>
        <div class="absolute right-[var(--page-padding)] top-[60px] w-[220px] rounded border border-border bg-surface-card p-3">
          <div class="flex flex-col">
            {navItems.map((item) => {
              const active = pathname === item.href;
              return (
                <a
                  href={item.href}
                  class:list={[
                    'rounded px-3 py-3 text-[13px] transition-colors duration-200',
                    active ? 'font-semibold text-text' : 'text-text-secondary hover:text-text',
                  ]}
                  aria-current={active ? 'page' : undefined}
                >
                  {item.label}
                </a>
              );
            })}
          </div>
        </div>
      </details>
    </div>
  </div>
</nav>
