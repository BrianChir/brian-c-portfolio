---
import { analyticsAttributes } from '../lib/analytics';

interface Product {
  number: string;
  slug: string;
  name: string;
  category: string;
  status: string;
  artifact: string;
  url: string | null;
  urlLabel?: string;
  product: string;
  problem: string;
  solution: string;
  outcome: string;
}

interface Props {
  product: Product;
}

const { product } = Astro.props;
const artifactItems = product.artifact.split(/\s*·\s*/);
const statusTone = product.status.toLowerCase().includes('live')
  ? 'border-emerald-500/30 bg-emerald-500/10 text-emerald-200'
  : product.status.toLowerCase().includes('development')
    ? 'border-amber-500/35 bg-amber-500/10 text-amber-200'
    : 'border-border bg-surface-alt text-text-secondary';
---

<article id={product.slug} class="scroll-mt-24 border-t border-border px-0 py-10 transition-colors duration-200 hover:border-accent">
  <div class="grid gap-5 sm:grid-cols-[48px_minmax(0,1fr)]">
    <p class="m-0 font-display text-[28px] italic text-accent/60">{product.number}</p>
    <div>
      <div class="mb-3 flex flex-wrap items-center gap-2">
        <p class="m-0 text-label-sm font-semibold uppercase text-text-secondary">{product.category}</p>
        <span class:list={[
          'rounded border px-2.5 py-1 text-label-sm font-medium normal-case tracking-normal',
          statusTone,
        ]}>
          {product.status}
        </span>
      </div>
      <h2 class="mb-4 font-display text-case-title font-medium text-text">
        {product.url ? (
          <a
            href={product.url}
            class="ui-link cursor-pointer"
            {...analyticsAttributes('external_link_click', `product-${product.name}`)}
          >
            {product.name}
          </a>
        ) : (
          <span>{product.name}</span>
        )}
      </h2>

      {!product.url && product.urlLabel && (
        <p class="mb-4 text-small text-text-secondary">{product.urlLabel}</p>
      )}

      <div class="mb-4 grid items-start gap-4 md:grid-cols-[minmax(0,1fr)_240px]">
        <p class="m-0 max-w-measure text-body-sm text-text-secondary">{product.product}</p>
        <aside class="rounded-lg border border-border bg-surface-card p-4">
          <p class="mb-3 text-label-sm font-semibold uppercase text-text-secondary">Product evidence</p>
          <div class="space-y-2">
            {artifactItems.map((item) => (
              <p class="m-0 rounded border border-border bg-surface-alt px-3 py-2 text-body-xs text-text-secondary">{item}</p>
            ))}
          </div>
          {product.url && (
            <a
              href={product.url}
              class="ui-link mt-3 inline-flex min-h-12 cursor-pointer items-center text-body-xs font-semibold text-accent"
              {...analyticsAttributes('external_link_click', `product-evidence-${product.name}`)}
            >
              View supporting link
            </a>
          )}
        </aside>
      </div>

      <details class="group rounded-lg border border-border bg-surface-card">
        <summary class="flex min-h-12 cursor-pointer list-none items-center justify-between gap-4 px-5 py-4 text-left transition-colors duration-200 hover:bg-surface-alt">
          <span class="text-body-sm font-semibold text-text">Read problem, solution, and outcome</span>
          <span class="text-[22px] leading-none text-accent transition-transform duration-300 group-open:rotate-45" aria-hidden="true">+</span>
        </summary>
        <div class="grid gap-px border-t border-border bg-border sm:grid-cols-2">
          <section class="bg-surface-card p-5">
            <h3 class="mb-3 font-display text-subsection font-medium text-text">Problem</h3>
            <p class="m-0 max-w-measure text-body-sm text-text-secondary">{product.problem}</p>
          </section>
          <section class="bg-surface-card p-5">
            <h3 class="mb-3 font-display text-subsection font-medium text-text">Solution</h3>
            <p class="m-0 max-w-measure text-body-sm text-text-secondary">{product.solution}</p>
          </section>
          <section class="bg-surface-card p-5 sm:col-span-2">
            <h3 class="mb-3 font-display text-subsection font-medium text-text">Outcome</h3>
            <p class="m-0 max-w-measure text-body-sm text-text-secondary">{product.outcome}</p>
          </section>
        </div>
      </details>
    </div>
  </div>
</article>
