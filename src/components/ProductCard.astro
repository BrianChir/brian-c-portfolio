---
import { analyticsAttributes } from '../lib/analytics';
interface Thumbnail { label:string; alt:string; from:string; via:string; to:string; }
interface Product { number:string; slug:string; name:string; category:string; status:string; artifact:string; url:string|null; urlLabel?:string; product:string; thumbnail:Thumbnail; problem:string; solution:string; definingDecision:string; outcome:string; }
interface Props { product:Product; }
const { product } = Astro.props;
const images:Record<string,string> = {
  'PayGo-Solution':'/images/projects/daylipa.png', 'duka-plus':'/images/projects/duka.png', wealthtrack:'/images/projects/wealthtrack.png',
  'sank-election-platform':'/images/projects/sank.png', yodaai:'/images/projects/yoda.png', bizframer:'/images/projects/bizframer.png', 'bds-mentorship-platform':'/images/projects/bds.png'
};
const image = images[product.slug];
const tags = product.category.split(' · ');
---
<article id={product.slug} class="card grid scroll-mt-20 overflow-hidden lg:grid-cols-[minmax(360px,46%)_minmax(0,1fr)]">
  <div class="aspect-[16/9] overflow-hidden bg-surface-alt lg:aspect-auto lg:min-h-[420px]">{image ? <img src={image} alt={product.thumbnail.alt} class="h-full w-full object-cover transition-transform duration-300 hover:scale-[1.02]" loading="lazy" /> : <div class="flex h-full items-center justify-center font-display text-[26px] italic text-text-secondary">{product.name}</div>}</div>
  <div class="min-w-0 p-5 sm:p-7 lg:flex lg:flex-col lg:justify-center lg:p-9">
    <div class="mb-3 flex flex-col items-start gap-2 sm:flex-row sm:justify-between sm:gap-4"><p class="eyebrow">{product.number} · {product.category}</p><span class="text-[9px] uppercase text-text-muted">{product.artifact.split('·')[0]}</span></div>
    <h2 class="mb-3 font-display text-[24px] font-medium">{product.url ? <a href={product.url} class="ui-link" {...analyticsAttributes('external_link_click',`product-${product.slug}`)}>{product.name} ↗</a> : product.name}</h2>
    <div class="mb-3 flex flex-wrap gap-1"><span class="chip">{product.status}</span>{tags.map(tag=><span class="rounded-full bg-surface-alt px-2 py-1 text-[9px] text-text-secondary">{tag}</span>)}</div>
    <p class="mb-4 text-[12px] leading-5 text-text-secondary">{product.product}</p>
    <div class="soft-panel mb-4 flex flex-col items-start gap-3 px-4 py-3 text-[10px] sm:flex-row sm:justify-between"><span class="text-text-secondary">◉&nbsp; {product.definingDecision}</span><strong class="uppercase sm:shrink-0">{product.outcome.split('.')[0]}</strong></div>
    <a href={`/work/${product.slug.toLowerCase()}`} class="text-[10px] font-semibold">Read full story →</a>
  </div>
</article>
