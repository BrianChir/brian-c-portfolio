---
import { siteMeta } from '../data/site';
---
<footer class="border-t border-border">
  <div class="section-shell py-8 text-[10px] text-text-muted">
    <div class="flex flex-col justify-between gap-5 sm:flex-row">
      <div><p class="mb-1 font-semibold text-text">Brian Chirchir</p><p>Senior Product Manager &amp; Builder · Nairobi &amp; Global Remote</p></div>
      <div class="flex flex-wrap gap-x-4 gap-y-2 text-text-secondary"><a href="https://civanta.io">Civanta.io</a><a href={siteMeta.linkedin}>LinkedIn</a><a href="https://x.com/">Twitter/X</a><a href={siteMeta.github}>GitHub</a><a href={`mailto:${siteMeta.email}`}>{siteMeta.email}</a></div>
    </div>
    <div class="mt-7 flex justify-between border-t border-border pt-4"><span>© 2026 Brian Chirchir. All rights reserved.</span><span class="font-display italic">Crafted with editorial discipline</span></div>
  </div>
</footer>
