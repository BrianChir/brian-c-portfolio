---
export const prerender = true;
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import { heroInfo, stats } from '../data/home';
import { getProducts } from '../lib/products';
import { siteMeta } from '../data/site';
const products = (await getProducts()).slice(0,3);
const workImages = ['/images/projects/daylipa.png','/images/projects/duka.png','/images/projects/wealthtrack.png'];
const discipline = [
  ['01. Ground truth','Field interviews and ethnographic research in low-bandwidth, high-constraint contexts.'],
  ['02. System arch','Pragmatic data schemas, API contracts, USSD fallbacks, and offline sync mechanics.'],
  ['03. Ship cycle','Tight weekly iterations, engineering unblocking, telemetry, and automated audit trails.'],
  ['04. Unit adoption','Unit economics, payment recovery rates, merchant retention, and organizational trust.'],
];
---
<BaseLayout pathname="/">
  <Hero />
  <section class="section-shell pb-14">
    <div class="card grid grid-cols-2 overflow-hidden sm:grid-cols-4">{stats.map((stat)=><div class="border-b border-r border-border p-5 last:border-r-0 sm:border-b-0"><p class="font-display text-[34px] text-accent">{stat.number}</p><p class="mt-2 text-[11px] leading-5 text-text-secondary">{stat.label}</p></div>)}</div>
    <div class="mt-12 grid gap-4 sm:grid-cols-2">{heroInfo.map((item)=><article class="card p-6"><h2 class="mb-2 text-[14px] font-semibold text-text">{item.label}</h2><p class="text-[12px] leading-5 text-text-secondary">{item.value}</p></article>)}</div>
  </section>
  <section class="section-shell py-12">
    <div class="mb-7 flex items-end justify-between"><div><p class="text-[9px] uppercase tracking-widest text-text-muted">Selected work</p><h2 class="font-display text-section-title">Products I have helped build.</h2></div><a href="/work" class="text-[11px] font-semibold text-accent">View all portfolio items →</a></div>
    <div class="space-y-5">{products.map((product,i)=><article class="card grid overflow-hidden sm:grid-cols-[42%_1fr]"><div class="min-h-52 bg-surface-alt"><img src={workImages[i]} alt={product.thumbnail.alt} class="h-full w-full object-cover" loading="lazy" /></div><div class="flex flex-col justify-center p-6"><div class="mb-3 flex flex-wrap gap-1"><span class="chip">{product.status}</span><span class="chip">{product.category}</span></div><h3 class="mb-2 font-display text-[22px] font-medium">{product.name}</h3><p class="mb-5 text-[12px] leading-5 text-text-secondary">{product.product}</p><a href={`/work#${product.slug}`} class="self-end text-[11px] font-semibold">Read case study →</a></div></article>)}</div>
  </section>
  <section class="section-shell py-12"><div class="card p-8"><p class="mb-2 text-[9px] uppercase tracking-widest text-text-muted">Discipline &amp; execution</p><h2 class="mb-7 font-display text-[24px]">How I bridge technical complexity and user reality.</h2><div class="grid gap-2 sm:grid-cols-4">{discipline.map(([title,body])=><div class="soft-panel p-4"><h3 class="mb-2 text-[9px] font-bold uppercase text-accent">{title}</h3><p class="text-[11px] leading-5 text-text-secondary">{body}</p></div>)}</div></div></section>
  <section class="section-shell py-12"><div class="card px-7 py-14 text-center"><p class="eyebrow mb-3">Start a dialogue</p><h2 class="mx-auto mb-4 max-w-[560px] font-display text-[36px] leading-tight">Every engagement starts with a conversation.</h2><p class="mx-auto mb-6 max-w-[520px] text-[12px] text-text-secondary">If you're building something that needs a product person who has shipped under real constraints, I'd like to hear what you're working on.</p><div class="flex flex-wrap justify-center gap-3"><a href={siteMeta.bookingUrl} class="button-accent">Book a call →</a><a href={`mailto:${siteMeta.email}`} class="button-muted">✉&nbsp; Email directly: {siteMeta.email}</a></div></div></section>
</BaseLayout>
