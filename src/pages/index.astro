---
export const prerender = true;

import Hero from '../components/Hero.astro';
import InfoGrid from '../components/InfoGrid.astro';
import ProjectSummaryCard from '../components/ProjectSummaryCard.astro';
import StatsRow from '../components/StatsRow.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteMeta } from '../data/site';
import { analyticsAttributes } from '../lib/analytics';
import { heroInfo, stats, trustedOrganizations } from '../data/home';
import { getProducts } from '../lib/products';
import { getCollection } from 'astro:content';

const products = await getProducts();
const articles = (await getCollection('articles'))
  .filter((article) => article.data.status === 'published')
  .sort((a, b) => a.data.sortOrder - b.data.sortOrder)
  .slice(0, 3);
---

<BaseLayout
  pathname="/"
  title="Brian Chirchir | Senior Product Manager for Fintech, SaaS, AI & Civic Tech"
  description="Brian Chirchir is a Senior Product Manager in Nairobi building fintech, M-PESA, SaaS, AI, civic tech, and edtech products across East Africa and global remote teams."
>
  <Hero>
    <InfoGrid items={heroInfo} />
  </Hero>

  <StatsRow items={stats} />

  <section class="border-y border-border bg-surface-alt py-8">
    <div class="wide-shell">
      <p class="mb-4 text-label-sm font-semibold uppercase text-text-secondary">Built for and alongside</p>
      <div class="grid grid-cols-2 gap-2 sm:grid-cols-3 lg:grid-cols-5">
        {trustedOrganizations.map((organization) => (
          <div class="flex min-h-14 items-center justify-center rounded border border-border bg-surface-card px-3 py-2 text-center text-[13px] font-semibold text-text-secondary">
            {organization}
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="wide-shell py-12">
    <p class="mb-3 text-label font-semibold uppercase text-text-secondary">Products</p>
    <h2 class="mb-6 font-display text-section-title font-normal text-text">Built around real constraints.</h2>
    <div class="grid gap-4 md:grid-cols-2">
      {products.map((product) => (
        <ProjectSummaryCard
          number={product.number}
          category={product.category}
          status={product.status}
          title={product.name}
          description={product.product}
          href="/work"
        />
      ))}
    </div>
  </section>

  <section class="bg-surface-alt py-12">
    <div class="wide-shell">
      <p class="mb-3 text-label font-semibold uppercase text-text-secondary">Thinking</p>
      <div class="grid items-start gap-6 md:grid-cols-[minmax(0,1fr)_300px]">
        <div class="max-w-measure">
          <h2 class="mb-4 font-display text-section-title font-normal text-text">Lessons worth sharing.</h2>
          <p class="mb-5 text-body text-text-secondary">
            Essays and frameworks from 8+ years of building in fintech, civic tech, clean energy, and entrepreneurship training.
          </p>
          <div class="flex flex-wrap gap-3">
            <a
              href="/thinking"
              class="surface-hover inline-flex min-h-12 cursor-pointer items-center rounded border border-border bg-surface-card px-5 py-3 text-[13px] font-semibold text-text hover:border-accent"
              {...analyticsAttributes('cta_click', 'home-thinking')}
            >
              Read the thinking
            </a>
          </div>
        </div>
        <div class="rounded-lg border border-border bg-surface-card p-4">
          <p class="mb-3 text-label-sm font-semibold uppercase text-text-secondary">Published</p>
          <div class="space-y-2">
            {articles.map((article) => (
              <a
                href={`/thinking/${article.data.slug}`}
                class="surface-hover block rounded border border-border bg-surface-alt px-3 py-2 text-body-xs text-text-secondary hover:border-accent"
                {...analyticsAttributes('cta_click', `home-article-${article.data.slug}`)}
              >
                {article.data.title}
              </a>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="py-14">
    <div class="section-shell text-center">
      <p class="mb-3 text-label font-semibold uppercase text-text-secondary">What I bring</p>
      <h2 class="text-balance mb-4 font-display text-section-title font-normal text-text">
        Your product problem<br /><em class="text-accent">deserves someone who has shipped under pressure.</em>
      </h2>
      <p class="mx-auto mb-8 max-w-[520px] text-body text-text-secondary">
        I bring 8+ years of building across M-PESA, IoT, SaaS, and civic tech in markets where constraints are real, trust is earned, and there's no room for features that don't solve problems. If you're looking for a product person who can move from whiteboard to shipped code and take your team along, I'd like to hear what you're working on.
      </p>
      <div class="flex flex-wrap justify-center gap-3">
        <a
          href="/services"
          class="surface-hover inline-flex min-h-12 cursor-pointer items-center rounded bg-accent px-6 py-3 text-[13px] font-semibold text-surface transition-colors duration-200 hover:bg-text"
          {...analyticsAttributes('cta_click', 'home-services')}
        >
          Explore services
        </a>
        <a
          href={siteMeta.bookingUrl}
          class="surface-hover inline-flex min-h-12 cursor-pointer items-center rounded border border-border bg-surface-card px-6 py-3 text-[13px] font-semibold text-text transition-colors duration-200 hover:border-accent"
          {...analyticsAttributes('cta_click', 'home-value-prop-email')}
        >
          Start a conversation
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
