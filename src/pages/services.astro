---
export const prerender = true;
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteMeta } from '../data/site';
import { analyticsAttributes } from '../lib/analytics';
const waysToWork = [
  {
    number: '01',
    title: 'Full-time product role',
    body: "I'm looking for a senior product role where I can own a product area end-to-end — particularly in fintech, civic tech, or platforms serving emerging markets. Remote-first, async-friendly, outcome-driven. If your team is building something that needs someone who has shipped under real constraints, I'd like to hear about it.",
  },
  {
    number: '02',
    title: 'Contract product work',
    body: "I take on scoped engagements: product discovery sprints, technical specification, PRD and UAT documentation, M-PESA integration strategy, or AI product scoping. These typically run 2–8 weeks and end with a deliverable your team can build from. Recent examples: the SANK e-Election specification suite, the BDS Mentorship Platform UAT runbook with 107 test cases, and BizFramer's partnership framework with ICST Kenya.",
  },
  {
    number: '03',
    title: 'Advisory and collaboration',
    body: "If you're building in East Africa or emerging markets and want a sounding board — someone who has navigated M-PESA infrastructure, low-bandwidth constraints, and trust-first design — I'm happy to have that conversation. Some of the best work I've done started as a coffee chat, not a contract.",
  },
];
---
<BaseLayout pathname="/services" title="Work with Brian Chirchir | Senior Product Manager" description="Explore full-time, contract, and advisory ways to work with Brian Chirchir on products for emerging markets.">
  <section class="section-shell page-stack">
    <p class="eyebrow mb-3">Work with me</p>
    <h1 class="mb-5 font-display text-page-title font-normal">How we can work together.</h1>
    <p class="mb-12 max-w-[620px] text-[15px] leading-7 text-text-secondary">I take on product work in three ways — and I'm open to conversations that don't fit neatly into a box.</p>

    <div class="space-y-5">
      {waysToWork.map((way) => (
        <article class="card p-7 sm:p-9">
          <div class="grid gap-5 sm:grid-cols-[48px_1fr]">
            <span class="font-display text-[25px] italic text-accent">{way.number}</span>
            <div><h2 class="mb-3 font-display text-[25px] font-medium">{way.title}</h2><p class="text-[14px] leading-7 text-text-secondary">{way.body}</p></div>
          </div>
        </article>
      ))}
    </div>

    <div class="mt-12 rounded-md bg-[#171412] px-7 py-10 text-white sm:px-10">
      <p class="mb-3 text-[10px] font-semibold uppercase tracking-widest text-[#d98970]">Let's talk</p>
      <h2 class="mb-4 max-w-[620px] font-display text-[30px] leading-tight">Tell me what you're building, where it's stuck, or what you want to make possible.</h2>
      <p class="mb-7 max-w-[620px] text-[13px] leading-6 text-white/70">No polished brief required. A useful conversation is enough to find out whether I can help.</p>
      <div class="flex flex-wrap gap-3"><a href={siteMeta.bookingUrl} class="button-accent" {...analyticsAttributes('cta_click','work-with-me-booking')}>Book a call →</a><a href={`mailto:${siteMeta.email}`} class="inline-flex min-h-11 items-center px-2 text-[12px] font-semibold text-white">{siteMeta.email}</a></div>
    </div>
  </section>
</BaseLayout>
