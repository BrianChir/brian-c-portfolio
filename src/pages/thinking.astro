---
export const prerender = true;

import { getCollection } from 'astro:content';
import ArticleCard from '../components/ArticleCard.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

const articles = (await getCollection('articles'))
  .filter((article) => article.data.status === 'published')
  .sort((a, b) => a.data.sortOrder - b.data.sortOrder);
---

<BaseLayout
  pathname="/thinking"
  title="Product Thinking - Brian Chirchir | Fintech, M-PESA, AI & Civic Tech"
  description="Product teardowns, frameworks, and lessons from Brian Chirchir's work in fintech, M-PESA, PAYGO solar, civic tech, AI, and emerging-market SaaS."
>
  <section class="layout-shell pt-24 pb-10 lg:pt-28">
    <p class="mb-3 text-label font-semibold uppercase text-accent">Thinking</p>
    <h1 class="mb-3 font-display text-page-title font-normal text-text">Lessons from shipped work.</h1>
    <p class="reading-width text-body text-text-secondary">
      Product teardowns, use cases, and frameworks drawn from building in markets where the textbook does not apply: M-PESA, low-bandwidth design, civic trust, AI workflows, and entrepreneurship systems.
    </p>
  </section>

  <section class="wide-shell pb-20">
    <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
      {articles.map((article) => (
        <ArticleCard article={article.data} href={`/thinking/${article.data.slug}`} />
      ))}
    </div>
  </section>
</BaseLayout>
