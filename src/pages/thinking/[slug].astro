---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const articles = await getCollection('articles');
const article = articles.find((entry) => entry.data.slug === Astro.params.slug);

if (!article || article.data.status !== 'published') {
  return Astro.redirect('/thinking');
}

const { Content } = await render(article);
const articleStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: article.data.title,
  description: article.data.abstract,
  datePublished: article.data.publishedDate?.toISOString(),
  author: {
    '@type': 'Person',
    name: 'Brian Chirchir',
    jobTitle: 'Product Manager',
  },
  url: new URL(`/thinking/${article.data.slug}`, Astro.site ?? 'http://brianchirchir.tech').toString(),
};
---

<BaseLayout
  pathname={`/thinking/${article.data.slug}`}
  title={`${article.data.title} | Product Thinking - Brian Chirchir`}
  description={article.data.abstract}
  structuredData={articleStructuredData}
>
  <article class="section-shell pt-24 pb-20">
    <a href="/thinking" class="ui-link mb-6 inline-block cursor-pointer text-label-sm font-semibold uppercase text-accent">
      Back to thinking
    </a>
    <p class="mb-3 text-label-sm font-semibold uppercase text-accent">{article.data.category}</p>
    <h1 class="mb-4 max-w-measure font-display text-page-title font-normal text-text">{article.data.title}</h1>
    {article.data.readingTime && <p class="mb-8 text-small text-text-secondary">{article.data.readingTime}</p>}
    <div class="prose-shell max-w-measure">
      <Content />
    </div>
  </article>
</BaseLayout>
