---
export const prerender = true;

import BaseLayout from '../layouts/BaseLayout.astro';
import CredentialsGrid from '../components/CredentialsGrid.astro';
import EducationList from '../components/EducationList.astro';
import ExperienceList from '../components/ExperienceList.astro';
import PrincipleBlock from '../components/PrincipleBlock.astro';
import { credentials, education, experience, principles } from '../data/about';
import { siteMeta } from '../data/site';
import { analyticsAttributes } from '../lib/analytics';

const valuePropositions = [
  {
    headline: 'End-to-end product ownership.',
    detail:
      "Managed the complete lifecycle across seven products, from problem framing and user research through technical specification, delivery management, and post-launch iteration. At 4RDigital, this meant leading DayLipa and Duka+ across engineering teams, field operations, and international funder expectations.",
  },
  {
    headline: 'Infrastructure-aware product strategy.',
    detail:
      'M-PESA, USSD, offline-first flows, low-bandwidth constraints, and field teams on feature phones are not edge cases to me. DayLipa turned those constraints into a PAYGO reconciliation model that keeps 500+ solar pump devices manageable without treating payment delays as user failure.',
  },
  {
    headline: 'Methods turned into usable systems.',
    detail:
      'I preserve what makes a methodology credible while changing what makes it hard to use. That shows up in the BDS Mentorship Platform UAT runbook, BizFramer, SIYB training workflows, and research operations across a 33-country GBV/SRH study.',
  },
];

const aboutStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  name: 'About Brian Chirchir',
  description:
    'Brian Chirchir is a Product Manager, product builder, and ILO-certified trainer based in Nairobi, Kenya.',
  mainEntity: {
    '@type': 'Person',
    name: siteMeta.name,
    jobTitle: siteMeta.jobTitle,
    url: siteMeta.domain,
    sameAs: [siteMeta.linkedin, siteMeta.github],
  },
};
---

<BaseLayout
  pathname="/about"
  title="About Brian Chirchir | Product Manager in Nairobi, Kenya"
  description="Learn about Brian Chirchir, a Nairobi-based Product Manager and product builder with 8+ years across Safaricom/M-PESA, fintech, SaaS, civic tech, and enterprise platforms."
  structuredData={aboutStructuredData}
>
  <section class="section-shell pt-24 pb-20">
    <p class="mb-3 text-label font-semibold uppercase text-accent">About</p>
    <div class="mb-12 grid gap-8 md:grid-cols-[minmax(0,1fr)_260px] md:items-start">
      <div>
        <h1 class="mb-8 font-display text-page-title font-normal text-text">A senior product manager for trusted products in constrained markets.</h1>
        <div class="about-bio max-w-measure space-y-4 text-body text-text-secondary">
          <p class="text-left">I'm Brian Chirchir, a Nairobi-based Senior Product Manager, builder, and ILO-certified trainer with 8+ years of work across products used by more than 1M people and programmes spanning 30+ countries. I've shaped products at Safaricom/M-PESA, IntelliSOFT, GeoPoll, and 4RDigital, and I now run Civanta.io, where I'm building tools for financial inclusion and entrepreneurship training.</p>
          <p class="text-left">I hold an MSc from University West in Sweden, where I studied on a Swedish Institute scholarship and wrote my thesis on AI in project management through Activity Theory. That blend of the technical and the human is the thread through everything I do.</p>
          <p class="text-left">I work well with remote-first teams across time zones because much of my career has required clear asynchronous communication, structured evidence, and disciplined stakeholder alignment. Outside of product work, I'm a purpose-driven person who believes technology should reduce inequality, not widen it.</p>
        </div>
        <div class="mt-8 flex flex-wrap gap-3">
          <a
            href={siteMeta.bookingUrl}
            class="surface-hover inline-flex min-h-12 cursor-pointer items-center rounded bg-accent px-6 py-3 text-[13px] font-semibold text-surface transition-colors duration-200 hover:bg-text"
            {...analyticsAttributes('cta_click', 'about-booking')}
          >
            Start a conversation
          </a>
          <a
            href={siteMeta.cvRequestUrl}
            download
            class="surface-hover inline-flex min-h-12 cursor-pointer items-center rounded border border-border bg-surface-card px-6 py-3 text-[13px] font-semibold text-text transition-colors duration-200 hover:border-accent"
            {...analyticsAttributes('cta_click', 'about-cv-request')}
          >
            Download CV
          </a>
        </div>
      </div>
      <figure class="overflow-hidden rounded-lg border border-border bg-surface-card">
        <img src="/brian.png" alt="Brian Chirchir" class="aspect-[4/5] h-full w-full object-cover object-center" loading="lazy" />
        <figcaption class="border-t border-border px-4 py-3 text-body-xs text-text-secondary">
          Nairobi-based product builder, trainer, and founder.
        </figcaption>
      </figure>
    </div>

    <div class="border-t border-border pt-10">
      <h2 class="mb-8 font-display text-[22px] font-normal text-text">How I approach the work.</h2>
      {principles.map((principle) => <PrincipleBlock {...principle} />)}
      <p class="mt-6 text-body-sm text-text-secondary">
        These principles show up most clearly in the product stories, especially <a href="/work#daylipa-paygo" class="ui-link text-accent">PAYGO solar reconciliation</a>, <a href="/work#bds-mentorship-platform" class="ui-link text-accent">SIYB mentorship</a>, and <a href="/work#sank-election-platform" class="ui-link text-accent">secure alumni voting</a>.
      </p>
    </div>

    <div class="mt-12 border-t border-border pt-10">
      <h2 class="mb-8 font-display text-[22px] font-normal text-text">What I bring to the table.</h2>
      <div class="max-w-measure space-y-6">
        {valuePropositions.map((prop) => (
          <div>
            <p class="mb-2 text-body-sm font-bold text-text">{prop.headline}</p>
            <p class="m-0 text-body-sm text-text-secondary">{prop.detail}</p>
          </div>
        ))}
      </div>
      <a
        href="/competencies"
        class="ui-link mt-6 inline-flex min-h-12 cursor-pointer items-center text-body-sm font-medium text-accent"
        {...analyticsAttributes('cta_click', 'about-competencies')}
      >
        See the full competency evidence &rarr;
      </a>
    </div>

    <CredentialsGrid items={credentials} />

    <div class="mt-10 border-t border-border pt-10">
      <h2 class="mb-6 font-display text-[22px] font-normal text-text">Where I've shipped.</h2>
      <ExperienceList items={experience} />
      <a
        href={siteMeta.linkedin}
        class="ui-link mt-6 inline-flex min-h-12 cursor-pointer items-center text-body-sm font-medium text-accent"
        {...analyticsAttributes('external_link_click', 'about-linkedin-career')}
      >
        Full career history on LinkedIn &rarr;
      </a>
    </div>

    <div class="mt-8 border-t border-border pt-8">
      <h2 class="mb-6 font-display text-[22px] font-normal text-text">Education.</h2>
      <EducationList items={education} />
    </div>

    <div class="mt-10 border-t border-border pt-10">
      <h2 class="mb-4 font-display text-[22px] font-normal text-text">Building something under real constraints?</h2>
      <p class="mb-6 max-w-measure text-body-sm text-text-secondary">
        If you need a product person who has shipped under payment, infrastructure, field-operations, and stakeholder pressure, I would like to hear what you are working on.
      </p>
      <a
        href={siteMeta.bookingUrl}
        class="surface-hover inline-flex min-h-12 cursor-pointer items-center rounded bg-accent px-6 py-3 text-[13px] font-semibold text-surface transition-colors duration-200 hover:bg-text"
        {...analyticsAttributes('cta_click', 'about-final-cta')}
      >
        Start a conversation
      </a>
    </div>
  </section>
</BaseLayout>
