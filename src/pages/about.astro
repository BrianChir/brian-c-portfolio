---
export const prerender = true;

import BaseLayout from '../layouts/BaseLayout.astro';
import CredentialsGrid from '../components/CredentialsGrid.astro';
import EducationList from '../components/EducationList.astro';
import ExperienceList from '../components/ExperienceList.astro';
import PrincipleBlock from '../components/PrincipleBlock.astro';
import { credentials, education, experience, principles } from '../data/about';
import { siteMeta } from '../data/site';
import { analyticsAttributes } from '../lib/analytics';

const valuePropositions = [
  {
    headline: 'I ship the whole thing.',
    detail:
      "DayLipa needed a payment layer that worked on feature phones. I designed the M-PESA reconciliation engine, the USSD troubleshooting interface, and the business dashboard — then stayed through deployment across 50+ branches. I don't hand off a spec and disappear.",
  },
  {
    headline: 'I build for the hardest users first.',
    detail:
      "WealthTrack's first users weren't tech-savvy professionals — they were M-PESA-dependent workers on 3G connections who avoid app downloads. That constraint shaped every decision: PWA over native, offline-first over cloud-first, net worth visibility over budgeting guilt. The product is better because of who it was built for.",
  },
  {
    headline: 'I make methodologies work as software.',
    detail:
      "The ILO SIYB programme has trained millions on paper. BizFramer is turning it into a digital product — not by copying the workbook into a screen, but by understanding where the methodology breaks when digitised and redesigning around the break points. I spent 8 interviews learning where trainers lose trainees before writing a single requirement.",
  },
];

const aboutStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  name: 'About Brian Chirchir',
  description:
    'Brian Chirchir is a Product Manager, product builder, and ILO-certified trainer based in Nairobi, Kenya.',
  mainEntity: {
    '@type': 'Person',
    name: siteMeta.name,
    jobTitle: siteMeta.jobTitle,
    url: siteMeta.domain,
    sameAs: [siteMeta.linkedin, siteMeta.github],
  },
};
---

<BaseLayout
  pathname="/about"
  title="About Brian Chirchir | Product Manager in Nairobi, Kenya"
  description="Learn about Brian Chirchir, a Nairobi-based Product Manager and product builder with 8+ years across Safaricom/M-PESA, fintech, SaaS, civic tech, and enterprise platforms."
  structuredData={aboutStructuredData}
>
  <section class="section-shell page-stack">
    <p class="eyebrow mb-3">About —— The person behind the work</p>
    <div class="mb-10 grid gap-8 lg:grid-cols-[minmax(0,1fr)_300px] lg:items-start">
      <div>
        <h1 class="mb-8 font-display text-page-title font-normal text-text">How I think about product.</h1>
        <div class="about-bio max-w-[72ch] space-y-4 text-body text-text-secondary">
          <p class="text-left">I'm Brian — a product person based in Nairobi who believes technology should reduce inequality, not widen it. That conviction has shaped everything I've built: a payment platform that lets farmers buy solar pumps through M-PESA, a business plan tool that digitises the world's most-used entrepreneurship methodology, and an election system that treats trust as architecture.</p>
          <p class="text-left">I studied mathematics and computer science in Kenya, then earned a Swedish Institute scholarship to complete my master's in IT and Management at University West in Sweden — where I wrote my thesis on how AI fits (and doesn't fit) into real project planning. I'm PMP-certified, ILO SIYB-trained, and a McKinsey Forward alumnus. I also know that none of those credentials matter as much as whether the product actually works for the person using it.</p>
          <p class="text-left">I work async-first across time zones. My products have shipped for London-based organisations, Commonwealth-commissioned programmes, and Nairobi-based enterprises — all from the same desk in Kenya.</p>
        </div>
        <div class="mt-8 flex flex-wrap gap-3">
          <a
            href={siteMeta.bookingUrl}
            class="surface-hover inline-flex min-h-12 cursor-pointer items-center rounded bg-accent px-6 py-3 text-[13px] font-semibold text-surface transition-colors duration-200 hover:bg-text"
            {...analyticsAttributes('cta_click', 'about-booking')}
          >
            Start a conversation
          </a>
          <a
            href={siteMeta.cvRequestUrl}
            download
            class="surface-hover inline-flex min-h-12 cursor-pointer items-center rounded border border-border bg-surface-card px-6 py-3 text-[13px] font-semibold text-text transition-colors duration-200 hover:border-accent"
            {...analyticsAttributes('cta_click', 'about-cv-request')}
          >
            Download CV
          </a>
        </div>
      </div>
      <figure class="glass-panel-strong tech-frame overflow-hidden rounded-lg">
        <img src="/brian.png" alt="Brian Chirchir" class="aspect-[4/5] h-full w-full object-cover object-center" loading="lazy" />
        <figcaption class="border-t border-border px-4 py-3 text-body-xs text-text-secondary">
          Nairobi-based product builder, trainer, and founder.
        </figcaption>
      </figure>
    </div>

    <div class="section-divider border-t border-border">
      <h2 class="mb-8 font-display text-[22px] font-normal text-text">How I approach the work.</h2>
      <div class="grid gap-5 lg:grid-cols-3">
        {principles.map((principle) => <PrincipleBlock {...principle} />)}
      </div>
      <p class="mt-6 max-w-[78ch] text-body-sm text-text-secondary">
        These principles show up most clearly in the product stories, especially <a href="/work#daylipa-paygo" class="ui-link text-accent">PAYGO solar reconciliation</a>, <a href="/work#bds-mentorship-platform" class="ui-link text-accent">SIYB mentorship</a>, and <a href="/work#sank-election-platform" class="ui-link text-accent">secure alumni voting</a>.
      </p>
    </div>

    <div class="section-divider border-t border-border">
      <h2 class="mb-8 font-display text-[22px] font-normal text-text">What building the products taught me.</h2>
      <div class="grid gap-5 lg:grid-cols-3">
        {valuePropositions.map((prop) => (
          <div class="glass-panel tech-frame rounded-lg p-5">
            <p class="mb-2 text-body-sm font-bold text-text">{prop.headline}</p>
            <p class="m-0 text-body-sm text-text-secondary">{prop.detail}</p>
          </div>
        ))}
      </div>
    </div>

    <CredentialsGrid items={credentials} />

    <div class="section-divider border-t border-border">
      <h2 class="mb-6 font-display text-[22px] font-normal text-text">Where I've shipped.</h2>
      <ExperienceList items={experience} />
      <a
        href={siteMeta.linkedin}
        class="ui-link mt-6 inline-flex min-h-12 cursor-pointer items-center text-body-sm font-medium text-accent"
        {...analyticsAttributes('external_link_click', 'about-linkedin-career')}
      >
        Full career history on LinkedIn &rarr;
      </a>
    </div>

    <div class="section-divider border-t border-border">
      <h2 class="mb-6 font-display text-[22px] font-normal text-text">Education.</h2>
      <EducationList items={education} />
    </div>

    <div class="section-divider border-t border-border">
      <h2 class="mb-4 font-display text-[22px] font-normal text-text">Building something under real constraints?</h2>
      <p class="mb-6 max-w-measure text-body-sm text-text-secondary">
        If you need a product person who has shipped under payment, infrastructure, field-operations, and stakeholder pressure, I would like to hear what you are working on.
      </p>
      <a
        href={siteMeta.bookingUrl}
        class="surface-hover inline-flex min-h-12 cursor-pointer items-center rounded bg-accent px-6 py-3 text-[13px] font-semibold text-surface transition-colors duration-200 hover:bg-text"
        {...analyticsAttributes('cta_click', 'about-final-cta')}
      >
        Start a conversation
      </a>
    </div>
  </section>
</BaseLayout>
